<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="3. Hotel Room Booking System"/>
        <attribute name="authors" value="Jasmin Ivy Fedilo"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2025-09-19 03:38:37 PM"/>
        <attribute name="created" value="SmFzbWluIEl2eSBGZWRpbG87TUlOU0VMOzIwMjUtMDktMTk7MDM6Mjc6MDIgUE07MzMyMw=="/>
        <attribute name="edited" value="SmFzbWluIEl2eSBGZWRpbG87TUlOU0VMOzIwMjUtMDktMTk7MDM6Mzg6MzcgUE07MTszNDQx"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="roomType" type="String" array="False" size=""/>
            <declare name="guests, days, feePerDay, capacity, totalFee" type="Integer" array="False" size=""/>
            <output expression="&quot;Enter room type (single/double/family): &quot;" newline="True"/>
            <input variable="roomType"/>
            <output expression="&quot;Enter number of guests: &quot;" newline="True"/>
            <input variable="guests"/>
            <output expression="&quot;Enter number of days: &quot;" newline="True"/>
            <input variable="days"/>
            <if expression="roomType == &quot;single&quot;">
                <then>
                    <assign variable="feePerDay" expression="1500"/>
                    <assign variable="capacity" expression="1"/>
                </then>
                <else>
                    <if expression="roomType == &quot;double&quot;">
                        <then>
                            <assign variable="feePerDay" expression="2500"/>
